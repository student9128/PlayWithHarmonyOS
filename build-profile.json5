{
  "app": {
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compatibleSdkVersion": "6.0.0(20)",
        "label": "$string:app_name",
        "bundleName": "com.kevin.default",
        "runtimeOS": "HarmonyOS",
        "targetSdkVersion": "6.1.1(24)"
      },
      {
        "name": "dev",
        "signingConfig": "default",
        "compatibleSdkVersion": "6.0.0(20)",
        "label": "$string:app_name_dev",
        "bundleName": "com.kevin.default_dev",
        "runtimeOS": "HarmonyOS"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
        "buildOption": {
          "debuggable": true
        }
      },
      {
        "name": "release",
        "buildOption": {
          "debuggable": false
        }
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        },
        {
          "name": "dev",
          "applyToProducts": [
            "dev"
          ]
        }
      ]
    }
  ]
}